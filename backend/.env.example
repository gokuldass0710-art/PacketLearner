# PacketLearner Backend Configuration

# Path to the TShark executable.
# On Windows, defaults to C:\Program Files\Wireshark\tshark.exe if not set.
# On Linux/macOS, set to /usr/bin/tshark or path from `which tshark`.
TSHARK_PATH=C:\Program Files\Wireshark\tshark.exe

# Maximum allowed capture file upload size in megabytes
MAX_UPLOAD_SIZE_MB=50

# Maximum execution timeout in seconds for TShark analysis subprocess
ANALYSIS_TIMEOUT_SECONDS=30

# Packet records response limits (to prevent unbounded response payloads)
DEFAULT_PACKET_LIMIT=1000
MAX_PACKET_LIMIT=5000

# Server Host and Port
HOST=127.0.0.1
PORT=8000

# Allowed CORS origins (comma-separated, local development only)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# OpenAI Assistant (keep the key server-side; never add it to frontend variables)
OPENAI_API_KEY=
# Set this to a model enabled for your OpenAI API account.
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=30
